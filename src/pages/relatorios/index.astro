---
import Base from '../../layouts/Base.astro';
import ReportCard from '../../components/ReportCard.astro';
import { getRelatoriosOrdenados } from '../../lib/relatorios';

const relatorios = await getRelatoriosOrdenados();

const semanas = relatorios.map((r) => ({ valor: String(r.data.edicao), rotulo: `Semana ${r.data.edicao}` }));

const plataformasSet = new Set<string>();
const temasSet = new Set<string>();
for (const r of relatorios) {
  r.data.plataformas.forEach((p) => plataformasSet.add(p));
  r.data.temas.forEach((t) => temasSet.add(t));
}
const plataformas = [...plataformasSet].map((v) => ({ valor: v, rotulo: v }));
const temas = [...temasSet].sort().map((v) => ({ valor: v, rotulo: v }));

// "todas as semanas/plataformas" (feminino) vs "todos os temas" (masculino)
const grupos = [
  { chave: 'semana', nome: 'Semana', todos: 'Todas', opcoes: semanas },
  { chave: 'plataforma', nome: 'Plataforma', todos: 'Todas', opcoes: plataformas },
  { chave: 'tema', nome: 'Temas', todos: 'Todos', opcoes: temas },
].filter((g) => g.opcoes.length > 0);
---

<Base
  title="Relatórios"
  description="Todas as edições semanais do Brasil Online, com filtro por semana, plataforma e tema."
>
  <section class="hero-curto band-dark">
    <div class="container">
      <span class="mono kicker">Acervo</span>
      <h1>Relatórios</h1>
      <p class="contagem mono tabular">{relatorios.length} edições publicadas</p>
    </div>
  </section>

  <section class="lista">
    <div class="container">
      <div class="filtros" id="filtros">
        {
          grupos.map((g) => (
            <details class="filtro" data-grupo={g.chave} data-todos={g.todos}>
              <summary>
                <span class="rotulo">{g.nome}</span>
                <span class="estado mono" data-estado>
                  {g.todos}
                </span>
                <span class="seta" aria-hidden="true" />
              </summary>
              <div class="painel">
                {g.opcoes.map((o) => (
                  <label class="opcao">
                    <input type="checkbox" value={o.valor} data-grupo={g.chave} />
                    <span>{o.rotulo}</span>
                  </label>
                ))}
              </div>
            </details>
          ))
        }

        <div class="acoes">
          <button type="button" id="aplicar-filtros" class="aplicar mono" disabled>
            Aplicar
          </button>
          <button type="button" id="limpar-filtros" class="limpar mono">
            Limpar
          </button>
        </div>
      </div>

      <p class="resultado mono tabular" id="resultado" aria-live="polite"></p>

      <div class="cards" id="lista-relatorios">
        {relatorios.map((r) => <ReportCard relatorio={r} mostrarTags />)}
      </div>

      <p class="vazio mono" id="estado-vazio" hidden>
        Nenhuma edição encontrada com esses filtros.
      </p>
    </div>
  </section>
</Base>

<script>
  const raiz = document.getElementById('filtros')!;
  const detalhes = [...raiz.querySelectorAll<HTMLDetailsElement>('details.filtro')];
  const cards = [...document.querySelectorAll<HTMLElement>('#lista-relatorios .report-card')];
  const vazio = document.getElementById('estado-vazio')!;
  const resultado = document.getElementById('resultado')!;
  const btnAplicar = document.getElementById('aplicar-filtros') as HTMLButtonElement;
  const btnLimpar = document.getElementById('limpar-filtros') as HTMLButtonElement;

  type Selecao = Record<string, string[]>;

  /** O que está de fato filtrando a lista. Marcar caixa não mexe aqui — só o Aplicar. */
  let aplicado: Selecao = { semana: [], plataforma: [], tema: [] };

  /** O que está marcado nos painéis agora. */
  function marcado(): Selecao {
    const s: Selecao = { semana: [], plataforma: [], tema: [] };
    for (const grupo of Object.keys(s)) {
      s[grupo] = [
        ...raiz.querySelectorAll<HTMLInputElement>(`input[data-grupo="${grupo}"]:checked`),
      ].map((i) => i.value);
    }
    return s;
  }

  const mesmo = (a: string[], b: string[]) =>
    a.length === b.length && [...a].sort().join('|') === [...b].sort().join('|');

  const temPendencia = () => {
    const m = marcado();
    return Object.keys(aplicado).some((g) => !mesmo(m[g], aplicado[g]));
  };

  // clique fora fecha qualquer painel aberto
  document.addEventListener('click', (e) => {
    if (!raiz.contains(e.target as Node)) {
      detalhes.forEach((d) => (d.open = false));
      return;
    }
    detalhes.forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });

  // só um painel aberto por vez
  detalhes.forEach((d) => {
    d.querySelector('summary')?.addEventListener('click', () => {
      detalhes.forEach((outro) => {
        if (outro !== d) outro.open = false;
      });
    });
  });

  /** Rótulo do gatilho reflete o MARCADO; o âmbar reflete o APLICADO. */
  function atualizarGatilhos() {
    const m = marcado();
    detalhes.forEach((d) => {
      const grupo = d.dataset.grupo!;
      const sel = m[grupo] ?? [];
      const estado = d.querySelector('[data-estado]')!;
      estado.textContent =
        sel.length === 0
          ? (d.dataset.todos ?? 'Todos')
          : `${sel.length} selecionada${sel.length > 1 ? 's' : ''}`;
      d.classList.toggle('ativo', (aplicado[grupo] ?? []).length > 0);
    });
    btnAplicar.disabled = !temPendencia();
  }

  function aplicar() {
    aplicado = marcado();

    let visiveis = 0;
    cards.forEach((card) => {
      const edicao = card.dataset.edicao ?? '';
      const cardPlataformas = (card.dataset.plataformas ?? '').split('|');
      const cardTemas = (card.dataset.temas ?? '').split('|');

      const passaSemana = aplicado.semana.length === 0 || aplicado.semana.includes(edicao);
      const passaPlataforma =
        aplicado.plataforma.length === 0 ||
        aplicado.plataforma.some((p) => cardPlataformas.includes(p));
      const passaTema =
        aplicado.tema.length === 0 || aplicado.tema.some((t) => cardTemas.includes(t));

      const passa = passaSemana && passaPlataforma && passaTema;
      card.hidden = !passa;
      if (passa) visiveis++;
    });

    vazio.hidden = visiveis > 0;

    // anuncia uma vez só, no clique — não a cada caixa marcada
    const filtrando = Object.values(aplicado).some((v) => v.length > 0);
    resultado.textContent = filtrando
      ? `${visiveis} ${visiveis === 1 ? 'edição encontrada' : 'edições encontradas'}`
      : '';

    detalhes.forEach((d) => (d.open = false));
    atualizarGatilhos();
  }

  // marcar caixa não filtra nada — só acende o Aplicar
  raiz.addEventListener('change', atualizarGatilhos);

  btnAplicar.addEventListener('click', aplicar);

  btnLimpar.addEventListener('click', () => {
    raiz.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((i) => (i.checked = false));
    aplicar();
  });

  atualizarGatilhos();
</script>

<style>
  .hero-curto {
    padding-block: var(--space-7) var(--space-6);
  }

  .kicker {
    /* creme, não azul-céu: 11,76:1 (AAA) */
    color: var(--cream);
    display: block;
    margin-bottom: var(--space-2);
  }

  .contagem {
    color: var(--cream);
    margin-top: var(--space-3);
  }

  .lista {
    padding-block: var(--space-7) var(--space-9);
  }

  /* ---------- filtros ---------- */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-thin) solid var(--mist-gray);
  }

  .filtro {
    position: relative;
  }

  .filtro summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    padding: var(--space-2) var(--space-4);
    border: var(--border-thin) solid var(--navy);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .filtro summary::-webkit-details-marker {
    display: none;
  }

  .filtro .rotulo {
    color: var(--navy);
    font-weight: 500;
  }

  .filtro .estado {
    color: var(--graphite);
    font-size: 0.688rem;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
  }

  /* seta em CSS puro — o manual não define sistema de ícones */
  .seta {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--navy);
    margin-left: var(--space-1);
    transition: transform var(--ease);
  }

  .filtro[open] .seta {
    transform: rotate(180deg);
  }

  /* Âmbar = filtro APLICADO, não apenas marcado.
     Preenchimento âmbar com texto grafite: 7,35:1 (AAA). */
  .filtro.ativo summary {
    background: var(--amber);
    border-color: var(--navy);
  }

  .filtro.ativo .rotulo,
  .filtro.ativo .estado {
    color: var(--graphite);
  }

  .filtro.ativo .seta {
    border-top-color: var(--graphite);
  }

  .painel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 220px;
    padding: var(--space-4);
    background: var(--cream);
    border: var(--border-thin) solid var(--navy);
    border-radius: var(--radius);
  }

  .opcao {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* alvo de toque ≥24px (WCAG 2.5.8) — sem isso o label media só 22px de
       altura em mobile, abaixo do mínimo AA */
    min-height: 32px;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .opcao input {
    accent-color: var(--navy);
  }

  .acoes {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .aplicar {
    padding: var(--space-2) var(--space-5);
    border: var(--border-thin) solid var(--navy);
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--cream);
    font-size: 0.75rem;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity var(--ease);
  }

  .aplicar:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .limpar {
    background: none;
    border: none;
    color: var(--graphite);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    font-size: 0.75rem;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    padding: var(--space-2) var(--space-3);
  }

  .limpar:hover {
    color: var(--navy);
  }

  /* ---------- lista ---------- */
  .resultado {
    color: var(--graphite);
    margin-bottom: var(--space-4);
    min-height: 1em;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .vazio {
    color: var(--graphite);
    text-align: center;
    padding-block: var(--space-8);
  }
</style>
