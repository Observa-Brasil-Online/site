---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import Card from '../../components/Card.astro';
import ReportCard from '../../components/ReportCard.astro';
import AvisoTextoIA from '../../components/AvisoTextoIA.astro';
import { getRelatoriosOrdenados, formatarPeriodo, comoCitar } from '../../lib/relatorios';

export async function getStaticPaths() {
  const relatorios = await getCollection('relatorios');
  return relatorios.map((r) => ({ params: { id: r.id }, props: { relatorio: r } }));
}

const { relatorio } = Astro.props;
const r = relatorio.data;
const { Content } = await render(relatorio);

const todos = await getRelatoriosOrdenados();
const relacionados = todos.filter((rel) => rel.id !== relatorio.id).slice(0, 2);

const citacao = comoCitar(r);
const urlPagina = new URL(Astro.url.pathname, Astro.site).toString();
const textoCompartilhar = encodeURIComponent(`${r.titulo} — Brasil Online`);
---

<Base title={r.titulo} description={r.chamada} ogImage={`/og/${relatorio.id}.png`}>
  <section class="hero-relatorio band-dark">
    <div class="container">
      <a class="voltar mono" href="/relatorios">← Voltar para Relatórios</a>
      <span class="mono kicker">
        Semana {r.edicao} · {formatarPeriodo(r.periodoInicio, r.periodoFim)}
      </span>
      <h1>{r.titulo}</h1>
      <div class="tags">
        {r.plataformas.map((p) => <Badge tone="cream">{p}</Badge>)}
        {r.temas.map((t) => <Badge tone="amber">{t}</Badge>)}
      </div>
      <div class="actions">
        <Button variant="amber" href={r.pdf} download>Baixar relatório (PDF)</Button>
      </div>
    </div>
  </section>

  <section class="corpo">
    <div class="container grid-detalhe">
      <div class="apresentacao">
        <Content />
        {r.apresentacaoGeradaPorIA && <AvisoTextoIA />}
      </div>

      <aside class="sidebar">
        <Card surface="cream">
          <span class="mono card-titulo">Ações</span>
          <div class="acoes-lista">
            <Button href={r.pdf} variant="primary" size="sm" download>Baixar PDF</Button>
            <a class="link-share" href={`https://twitter.com/intent/tweet?text=${textoCompartilhar}&url=${encodeURIComponent(urlPagina)}`} target="_blank" rel="noopener noreferrer">Compartilhar no X</a>
            <a class="link-share" href={`https://wa.me/?text=${textoCompartilhar}%20${encodeURIComponent(urlPagina)}`} target="_blank" rel="noopener noreferrer">Compartilhar no WhatsApp</a>
            <a class="link-share" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlPagina)}`} target="_blank" rel="noopener noreferrer">Compartilhar no Facebook</a>
            <button type="button" class="link-share copiar" data-url={urlPagina}>Copiar link</button>
          </div>
        </Card>

        <Card surface="block">
          <span class="mono card-titulo">Como citar esta edição</span>
          <p class="citacao">{citacao}</p>
          <button type="button" class="link-share copiar" data-url={citacao}>Copiar referência</button>
        </Card>
      </aside>
    </div>
  </section>

  {
    relacionados.length > 0 && (
      <section class="relacionados">
        <div class="container">
          <span class="mono eyebrow">Edições relacionadas</span>
          <div class="relacionados-grid">
            {relacionados.map((rel) => (
              <ReportCard relatorio={rel} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copiar').forEach((botao) => {
    botao.addEventListener('click', async () => {
      const valor = botao.dataset.url ?? '';
      try {
        await navigator.clipboard.writeText(valor);
        const original = botao.textContent;
        botao.textContent = 'Copiado';
        setTimeout(() => (botao.textContent = original), 1600);
      } catch {
        // clipboard indisponível (contexto não seguro, permissão negada) — silencioso
      }
    });
  });
</script>

<style>
  .hero-relatorio {
    padding-block: var(--space-7) var(--space-8);
  }

  .voltar {
    display: inline-block;
    /* alvo de toque ≥24px (WCAG 2.5.8) — texto sozinho media só 16px */
    padding-block: var(--space-2);
    margin-block: calc(var(--space-2) * -1) calc(var(--space-5) - var(--space-2));
    color: var(--sky-blue);
    text-decoration: none;
  }
  .voltar:hover {
    text-decoration: underline;
  }

  .kicker {
    color: var(--sky-blue);
    display: block;
    margin-bottom: var(--space-3);
  }

  .hero-relatorio h1 {
    max-width: 26ch;
    margin-bottom: var(--space-5);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .corpo {
    padding-block: var(--space-8);
  }

  .grid-detalhe {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 760px) {
    .grid-detalhe {
      grid-template-columns: 1fr;
    }
  }

  .apresentacao :global(p) {
    margin-bottom: var(--space-5);
    max-width: var(--prose-max);
  }

  .apresentacao :global(ul) {
    margin-bottom: var(--space-5);
    max-width: var(--prose-max);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .apresentacao :global(li) {
    line-height: 1.55;
  }

  .apresentacao :global(li > ul) {
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .apresentacao :global(em) {
    display: block;
    font-size: 0.8125rem;
    color: var(--graphite);
    opacity: 0.75;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    position: sticky;
    top: var(--space-6);
  }

  .card-titulo {
    display: block;
    color: var(--amber-dark);
    margin-bottom: var(--space-4);
  }

  .block .card-titulo {
    color: var(--navy);
  }

  .acoes-lista {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .link-share {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--link);
    text-decoration: none;
    background: none;
    border: none;
    /* alvo de toque ≥24px (WCAG 2.5.8) — sem padding, media 17–20px.
       Sem compensação de margem negativa: numa lista vertical apertada isso
       fazia os alvos se sobreporem (testado e revertido). */
    padding-block: var(--space-2);
    cursor: pointer;
    text-align: left;
  }

  .link-share:hover {
    text-decoration: underline;
  }

  .citacao {
    font-size: 0.875rem;
    line-height: 1.55;
    font-style: italic;
    margin-bottom: var(--space-4);
  }

  .relacionados {
    padding-block: var(--space-8) var(--space-9);
  }

  .eyebrow {
    display: block;
    color: var(--amber-dark);
    margin-bottom: var(--space-5);
  }

  .relacionados-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }
</style>
