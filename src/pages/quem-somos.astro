---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { AMOSTRA } from '../config';

const integrantes = await getCollection('integrantes');

const PREFIXOS = /^(Prof\.|Profa\.?|Profa|Dra\.|Dr\.|Ms\.|Bel\.)\s+/;
function chaveOrdenacao(nome: string) {
  let s = nome;
  while (PREFIXOS.test(s)) s = s.replace(PREFIXOS, '');
  return s.toLocaleLowerCase('pt-BR');
}

/**
 * Recorte de publicação: só aparece quem devolveu as informações da ficha.
 * `formacaoAtual` é o critério — é o único campo que todo mundo consegue
 * preencher (Lattes nem toda pessoa tem, rede social é opcional).
 *
 * Enquanto os dados não voltam, PLACEHOLDER=true mantém os 41 nomes na tela
 * para desenvolvimento. Virar false antes de publicar.
 */
const PLACEHOLDER = true;

const todos = [...integrantes].sort((a, b) =>
  chaveOrdenacao(a.data.nome).localeCompare(chaveOrdenacao(b.data.nome), 'pt-BR')
);

const equipe = PLACEHOLDER ? todos : todos.filter((p) => p.data.formacaoAtual);
---

<Base
  title="Quem somos"
  description="O Brasil Online é um projeto do OBSERVA — Observatório de Conflitos na Internet, da UFABC."
>
  <section class="hero-institucional band-dark">
    <div class="container hero-inner">
      <div class="texto">
        <span class="mono kicker">O que é</span>
        <h1>Mapear a disputa</h1>
        <p class="lede">
          O Brasil Online é um projeto do OBSERVA — Observatório de Conflitos na Internet, da UFABC.
          Toda semana medimos o debate político brasileiro nas plataformas digitais: quem publica, quem
          engaja e em torno de quais conflitos a disputa se organiza. Uma edição por semana, até a
          eleição.
        </p>
        <p class="lede">
          Como os campos de esquerda e direita se enfrentam nas principais plataformas digitais do país.
          Não é sobre quem tem razão. É sobre onde, como e com que intensidade a disputa acontece.
        </p>
      </div>

      <Card surface="cream" class="card-recorte">
        <span class="mono card-titulo">O recorte</span>
        <dl>
          <div>
            <dt class="tabular">{AMOSTRA.perfis}</dt>
            <dd>perfis<br />monitorados</dd>
          </div>
          <div>
            <dt class="tabular">{AMOSTRA.plataformas.length}</dt>
            <dd>plataformas<br />{AMOSTRA.plataformas.join(', ')}</dd>
          </div>
          <div>
            <dt class="campos">Esquerda<br />e Direita</dt>
            <dd>sempre<br />comparados</dd>
          </div>
        </dl>
      </Card>
    </div>
  </section>

  <section class="equipe">
    <div class="container">
      <div class="equipe-head">
        <span class="mono eyebrow">Equipe</span>
        <h2 class="type-fa">{equipe.length} pesquisadoras e pesquisadores</h2>
      </div>
      <div class="equipe-grid">
        {
          equipe.map((p) => (
            <div class="pessoa">
              <span class="nome">{p.data.nome}</span>
              {p.data.formacaoAtual && <span class="formacao">{p.data.formacaoAtual}</span>}
              <div class="links">
                {p.data.lattes && (
                  <a href={p.data.lattes} target="_blank" rel="noopener noreferrer">
                    Lattes
                  </a>
                )}
                {p.data.redeSocial && (
                  <a href={p.data.redeSocial} target="_blank" rel="noopener noreferrer">
                    Rede social
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-institucional {
    padding-block: var(--space-8);
  }

  .hero-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    align-items: flex-start;
  }

  .texto {
    flex: 1 1 380px;
    min-width: 0;
  }

  .kicker {
    /* creme: 11,76:1 (AAA) */
    color: var(--cream);
    display: block;
    margin-bottom: var(--space-3);
  }

  .hero-inner h1 {
    max-width: 14ch;
    margin-bottom: var(--space-5);
  }

  .lede {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--cream);
    max-width: 52ch;
    margin-bottom: var(--space-4);
  }

  :global(.card-recorte) {
    flex: 1 1 300px;
    max-width: 380px;
  }

  .card-titulo {
    display: block;
    color: var(--amber-dark);
    margin-bottom: var(--space-5);
  }

  dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* legenda ao lado do número, alinhada pela base */
  dl > div {
    display: flex;
    flex-wrap: wrap;
    /* centralizado, não pela linha de base — mesmo tratamento do StatCallout
       da Home. Importa mais ainda agora que a legenda quebra em duas linhas. */
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  /* 162, 3 e "Esquerda e Direita" — mesma forma e estilo, sem exceção para o
     item que é frase em vez de número */
  dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--navy);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--graphite);
    text-align: left;
  }

  /* ---------- equipe ---------- */
  .equipe {
    padding-block: var(--space-8);
  }

  .equipe-head {
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    display: block;
    color: var(--amber-dark);
    margin-bottom: var(--space-3);
  }

  .equipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--space-4);
  }

  .pessoa {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: var(--border-thin) solid var(--mist-gray);
    border-radius: var(--radius);
  }

  .nome {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--navy);
    line-height: 1.35;
  }

  .formacao {
    font-size: 0.8125rem;
    color: var(--graphite);
  }

  .links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 0.688rem;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
