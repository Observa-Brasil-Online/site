---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import StatCallout from '../components/StatCallout.astro';
import ComparisonBar from '../components/ComparisonBar.astro';
import ReportCard from '../components/ReportCard.astro';
import HeroBlocos from '../components/HeroBlocos.astro';
import SignatureLockup from '../components/SignatureLockup.astro';
import { SITE } from '../config';
import { getRelatoriosOrdenados, formatarPeriodo } from '../lib/relatorios';

const relatorios = await getRelatoriosOrdenados();
const ultima = relatorios[0];
const r = ultima?.data;

// só a edição imediatamente anterior à do hero
const anterior = relatorios[1];

// tira o ponto final: a chamada vira manchete, e manchete não leva ponto
const semPonto = (t: string) => t.replace(/\.\s*$/, '');

const camadas = [
  {
    n: '01',
    titulo: 'Coleta',
    texto:
      'Publicações e interações de perfis de lideranças políticas, influenciadores e jornalistas de destaque no debate público.',
  },
  {
    n: '02',
    titulo: 'Os números',
    texto:
      'Volume de publicações, interações e engajamento médio por post — por campo e por plataforma.',
  },
  {
    n: '03',
    titulo: 'As narrativas',
    texto:
      'Identificação dos principais conflitos discursivos do período — os temas em torno dos quais a disputa se organiza.',
  },
];
---

<Base title={SITE.name}>
  <section class="capa">
    <div class="container capa-inner">
      <div class="capa-marca">
        <SignatureLockup orientation="vertical" size={52} wordmarkBrasilOnline />
        <div class="actions">
          <Button variant="amber" href="/relatorios">
            Ver relatórios
          </Button>
          <Button variant="ghost" href="/quem-somos">
            Quem somos
          </Button>
        </div>
      </div>

      <div class="capa-texto">
        <h1>A eleição de 2026 também acontece no feed</h1>
        <p class="lede">
          O Brasil Online é um projeto do OBSERVA — Observatório de Conflitos na Internet, da UFABC.
          Toda semana, até a eleição de outubro, medimos como os campos de esquerda e direita
          disputam as redes sociais: quem publica, quem engaja e em torno de quais conflitos a
          disputa se organiza.
        </p>
      </div>
    </div>
  </section>

  {
    r && (
      <section class="hero band-dark">
        <div class="container hero-inner">
          <div class="hero-texto">
            <span class="mono kicker">
              Semana {r.edicao} · {formatarPeriodo(r.periodoInicio, r.periodoFim)}
            </span>
            <h1>{r.titulo}</h1>
            <p class="lede">{r.chamada}</p>
            <div class="actions">
              <Button variant="amber" href={r.pdf} download>
                Baixar relatório (PDF)
              </Button>
              <Button variant="ghost-dark" href="/relatorios">
                Ver todas as edições
              </Button>
            </div>
          </div>

          {
            r?.dados?.interacoesEsquerda != null && r?.dados?.interacoesDireita != null && (
              <div class="hero-blocos">
                <HeroBlocos
                  esquerda={r.dados.interacoesEsquerda}
                  direita={r.dados.interacoesDireita}
                  plataformas={r.dados.plataformas}
                  edicao={r.edicao}
                />
              </div>
            )
          }
        </div>
      </section>
    )
  }

  {
    r && (
      <section class="destaque">
        <div class="container destaque-inner">
          <div class="destaque-texto">
            <span class="mono eyebrow">
              Semana {r.edicao} · {formatarPeriodo(r.periodoInicio, r.periodoFim)}
            </span>
            <h2>
              <a href={`/relatorios/${ultima.id}`}>{semPonto(r.chamada)}</a>
            </h2>
          </div>
          <div class="destaque-dados">
            <StatCallout
              value={`${r.dados?.interacoesDireita?.toLocaleString('pt-BR')}%`}
              label={`Interações da direita, semana ${r.edicao}`}
              legenda="ao-lado"
            />
            {r.dados?.interacoesEsquerda != null && r.dados?.interacoesDireita != null && (
              <ComparisonBar
                leftValue={r.dados.interacoesEsquerda}
                rightValue={r.dados.interacoesDireita}
                caption={`Interações por campo político na semana ${r.edicao}`}
              />
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="metodo band-block">
    <div class="container">
      <span class="mono eyebrow">Como funciona</span>
      <h2 class="type-fa">Três camadas de análise</h2>
      <div class="camadas">
        {
          camadas.map((c) => (
            <Card surface="cream">
              <span class="mono num">{c.n}</span>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {
    anterior && (
      <section class="edicoes">
        <div class="container">
          <div class="edicoes-head">
            <div>
              <span class="mono eyebrow">Acervo</span>
              <h2 class="type-fa">Edição anterior</h2>
            </div>
            <Button href="/relatorios" variant="ghost">
              Ver todos
            </Button>
          </div>
          <div class="edicoes-grid">
            <ReportCard relatorio={anterior} />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- capa ---------- */
  .capa {
    padding-block: var(--space-8);
  }

  /* mesma proporção de coluna do .hero-inner logo abaixo — mantém as duas
     seções alinhadas verticalmente, dando simetria à página */
  .capa-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .capa-marca {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  /* SignatureLockup vertical centraliza por padrão (uso normal: rodapé,
     kit de marca); aqui a composição inteira é alinhada à esquerda */
  .capa-marca :global(.lockup.vertical) {
    align-items: flex-start;
    text-align: left;
  }

  .capa-marca :global(.lockup.vertical .frase) {
    justify-content: flex-start;
  }

  .capa-texto {
    text-align: left;
  }

  /* fonte menor que o padrão de h1 — aqui divide a largura com a coluna da
     marca, o tamanho de headline cheio (--type-headline-size) quebraria o
     layout ou forçaria min-width absurdo */
  .capa-texto h1 {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .capa-texto .lede {
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: 44ch;
    /* .lede é compartilhado com o .hero escuro logo abaixo, onde o creme
       faz sentido — aqui o fundo é claro, então herdar aquele creme deixaria
       o texto quase ilegível */
    color: var(--graphite);
  }

  @media (max-width: 700px) {
    .capa-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .capa-inner .actions {
    width: 100%;
    justify-content: flex-start;
  }

  /* ---------- hero (edição mais recente) ---------- */
  .hero {
    padding-block: var(--space-8);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .hero-texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
    min-width: 0;
  }

  .hero-blocos {
    min-width: 0;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  .kicker {
    /* creme em vez de azul-céu: 11,76:1 (AAA) */
    color: var(--cream);
  }

  .hero h1 {
    max-width: 20ch;
  }

  .lede {
    font-size: var(--type-subtitle-size);
    font-weight: 400;
    line-height: 1.4;
    color: var(--cream);
    max-width: 52ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* ---------- destaque ---------- */
  .destaque {
    padding-block: var(--space-8);
  }

  .destaque-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    align-items: flex-start;
  }

  .destaque-texto,
  .destaque-dados {
    flex: 1 1 320px;
    min-width: 0;
  }

  .destaque-texto .eyebrow {
    display: block;
    color: var(--amber-dark);
    margin-bottom: var(--space-3);
  }

  .destaque-texto h2 {
    max-width: 26ch;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
  }

  .destaque-texto h2 a {
    color: inherit;
    text-decoration: none;
  }

  .destaque-texto h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .destaque-dados {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* ---------- método ---------- */
  .metodo {
    padding-block: var(--space-8);
  }

  .eyebrow {
    display: block;
    /* navy sobre cinza-névoa: 8,22:1 — o âmbar-escuro reprovava a 3,44:1 */
    color: var(--navy);
    margin-bottom: var(--space-3);
  }

  .camadas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .num {
    display: block;
    color: var(--amber-dark);
    margin-bottom: var(--space-2);
  }

  .camadas h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--space-2);
  }

  .camadas p {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* ---------- edição anterior ---------- */
  .edicoes {
    padding-block: var(--space-8);
  }

  .edicoes-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .edicoes-head .eyebrow {
    color: var(--amber-dark);
  }

  .edicoes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }
</style>
