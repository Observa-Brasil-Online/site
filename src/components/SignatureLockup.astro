---
import Symbol from './Symbol.astro';

/**
 * Assinatura OBSERVA — endosso institucional.
 * OBRIGATÓRIA em toda página. A única exceção prevista pelo manual é o símbolo
 * isolado como avatar de perfil.
 *
 * Wordmark e assinatura ficam na mesma linha, no mesmo tamanho: o destaque vem
 * do peso (800 vs 400), não do corpo. A altura acompanha o símbolo + 2px.
 */
interface Props {
  orientation?: 'horizontal' | 'vertical';
  onDark?: boolean;
  /** Vira link para a home quando true */
  asLink?: boolean;
  /** Altura do símbolo em px — o texto acompanha */
  size?: number;
}

const { orientation = 'horizontal', onDark = false, asLink = false, size = 34 } = Astro.props;
const Tag = asLink ? 'a' : 'div';

const alturaSimbolo = orientation === 'vertical' ? 56 : size;
// tipografia simétrica ao símbolo, 2px maior
const corpoTexto = alturaSimbolo + 2;
---

<Tag
  class:list={['lockup', orientation, { 'on-dark': onDark }]}
  style={`--corpo: ${corpoTexto}px`}
  {...asLink ? { href: '/', 'aria-label': 'Brasil Online — página inicial' } : {}}
>
  <Symbol variant={onDark ? 'negative' : 'primary'} size={alturaSimbolo} />
  <span class="frase">
    <span class="wordmark">OBSERVA</span>
    <span class="signature">Uma série do Brasil Online</span>
  </span>
</Tag>

<style>
  .lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .lockup.vertical {
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }

  /* Frase uniforme em tamanho: o título pesa, o subtítulo não. */
  .frase {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    min-width: 0;
    flex-wrap: wrap;
  }

  .vertical .frase {
    justify-content: center;
  }

  /* Frase uniforme em tamanho e família: wordmark e assinatura no mesmo corpo,
     ambos em Archivo. O destaque vem só do peso (800 vs 400). */
  .wordmark,
  .signature {
    font-family: var(--font-display);
    font-size: calc(var(--corpo) * 0.55);
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark {
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  .signature {
    font-weight: 400;
    letter-spacing: var(--type-signature-tracking);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .on-dark .wordmark {
    color: var(--cream);
  }
  /* creme em vez de azul-céu: 11,76:1 (AAA) contra os 5,65:1 anteriores */
  .on-dark .signature {
    color: var(--cream);
  }

  /* Em telas estreitas, "Uma série do Brasil Online" não cabe ao lado do
     wordmark sem estourar a largura do frame — nowrap fazia o texto vazar
     pra fora em vez de quebrar. Empilha e libera a quebra de linha. */
  @media (max-width: 480px) {
    .lockup:not(.vertical) {
      min-width: 0;
    }
    .lockup:not(.vertical) .frase {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .lockup:not(.vertical) .wordmark,
    .lockup:not(.vertical) .signature {
      white-space: normal;
    }
  }
</style>
