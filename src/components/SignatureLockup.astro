---
import Symbol from './Symbol.astro';

/**
 * Assinatura OBSERVA — endosso institucional.
 * OBRIGATÓRIA em toda página. A única exceção prevista pelo manual é o símbolo
 * isolado como avatar de perfil.
 *
 * Wordmark e assinatura ficam na mesma linha, no mesmo tamanho: o destaque vem
 * do peso (800 vs 400), não do corpo. A altura acompanha o símbolo + 2px.
 */
interface Props {
  orientation?: 'horizontal' | 'vertical';
  onDark?: boolean;
  /** Vira link para a home quando true */
  asLink?: boolean;
  /** Altura do símbolo em px — o texto acompanha */
  size?: number;
}

const { orientation = 'horizontal', onDark = false, asLink = false, size } = Astro.props;
const Tag = asLink ? 'a' : 'div';

// tamanho padrão maior no vertical (o empilhamento pede mais presença),
// mas ambas as orientações respeitam `size` quando informado
const alturaSimbolo = size ?? (orientation === 'vertical' ? 56 : 34);
// tipografia simétrica ao símbolo, 2px maior
const corpoTexto = alturaSimbolo + 2;
---

<Tag
  class:list={['lockup', orientation, { 'on-dark': onDark }]}
  style={`--corpo: ${corpoTexto}px`}
  {...asLink ? { href: '/', 'aria-label': 'Brasil Online — página inicial' } : {}}
>
  <Symbol variant={onDark ? 'negative' : 'primary'} size={alturaSimbolo} />
  <span class="frase">
    <span class="wordmark">OBSERVA</span>
    <span class="signature">
      {orientation === 'vertical' ? (
        <>
          Uma série do
          <br />
          Brasil Online
        </>
      ) : (
        'Uma série do Brasil Online'
      )}
    </span>
  </span>
</Tag>

<style>
  .lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .lockup.vertical {
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }

  /* Frase uniforme em tamanho: o título pesa, o subtítulo não. */
  .frase {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    min-width: 0;
    flex-wrap: wrap;
  }

  /* Coluna, não wrap de flex-row: sem isso, o wordmark "sobe" pra linha da
     assinatura sempre que o item de assinatura encolhe (ex.: depois de
     ganhar o <br/> abaixo, que reduz sua largura efetiva de item) — os dois
     precisam ficar sempre em linhas próprias, não depender de onde o
     wrap decide cortar. */
  .vertical .frase {
    flex-direction: column;
    justify-content: center;
  }

  /* Frase uniforme em tamanho e família: wordmark e assinatura no mesmo corpo,
     ambos em Archivo. O destaque vem só do peso (800 vs 400). */
  /* white-space normal (padrão) de propósito: quebra sozinho sempre que o
     espaço disponível apertar, sem depender de um breakpoint de viewport —
     útil tanto no header quanto em usos futuros com coluna estreita, como
     a capa da Home. */
  .wordmark,
  .signature {
    font-family: var(--font-display);
    font-size: calc(var(--corpo) * 0.55);
    line-height: 1;
  }

  .wordmark {
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  .signature {
    font-weight: 400;
    letter-spacing: var(--type-signature-tracking);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .on-dark .wordmark {
    color: var(--cream);
  }
  /* creme em vez de azul-céu: 11,76:1 (AAA) contra os 5,65:1 anteriores */
  .on-dark .signature {
    color: var(--cream);
  }

  /* Em telas estreitas, empilha wordmark e assinatura em vez de deixar os
     dois disputarem a mesma linha — a quebra de texto em si já é resolvida
     pelo white-space normal acima, isso aqui é só a preferência de layout. */
  @media (max-width: 480px) {
    .lockup {
      min-width: 0;
    }
    .lockup:not(.vertical) .frase {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }
</style>
