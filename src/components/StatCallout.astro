---
/**
 * StatCallout — o padrão "número-manchete", unidade de conteúdo característica
 * da série: número grande em Archivo ExtraBold + legenda mono.
 *
 * Contraste: âmbar puro como TEXTO em fundo claro reprova na WCAG (2.15:1).
 * O tom padrão resolve para âmbar escuro (4.92:1, AA). O tom 'amber-on-dark'
 * mantém o âmbar puro e só vale sobre navy (5.47:1, AA).
 */
interface Props {
  value: string;
  label: string;
  tone?: 'amber' | 'navy' | 'amber-on-dark';
  size?: 'md' | 'lg';
  /** 'abaixo' (padrão) ou 'ao-lado' — legenda alinhada à base do número */
  legenda?: 'abaixo' | 'ao-lado';
}

const { value, label, tone = 'amber', size = 'lg', legenda = 'abaixo' } = Astro.props;
---

<div class:list={['stat', tone, size, `leg-${legenda}`]}>
  <span class="value tabular">{value}</span>
  <span class="label">{label}</span>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .leg-ao-lado {
    flex-direction: row;
    /* centralizado, não pela linha de base — os dois elementos alinham pelo
       meio da própria altura, não pelo pé do número grande */
    align-items: center;
    gap: var(--space-4);
    /* nowrap no container: os dois ficam na mesma linha sempre.
       O label pode quebrar dentro de si mesmo (max-width abaixo). */
    flex-wrap: nowrap;
  }

  .leg-ao-lado .value {
    flex: none;
  }

  .leg-ao-lado .label {
    flex: 1 1 auto;
    min-width: 0;
  }

  .value {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .lg .value { font-size: clamp(3rem, 7vw, 5rem); }
  .md .value { font-size: clamp(2rem, 4vw, 2.75rem); }

  .label {
    font-family: var(--font-mono);
    /* maior que --type-label-size (12px) — legível como legenda de gráfico,
       não só como um rótulo de badge */
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--graphite);
    max-width: 28ch;
  }

  .amber .value { color: var(--amber-dark); }
  .navy .value { color: var(--navy); }

  .amber-on-dark .value { color: var(--amber); }
  .amber-on-dark .label { color: var(--sky-blue); }
</style>
